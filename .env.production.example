APP_NAME="Sistem Akuntansi Sekolah (SAS) Open Source"
INSTITUTION_NAME="Yayasan Pendidikan Contoh"
SCHOOL_NAME="Sekolah SAS"
# Opsional: alamat publik untuk bantuan instalasi pada halaman produk.
SUPPORT_EMAIL=
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_PORT=3000
TRUST_PROXY=true
COOKIE_SECURE=true
# Isi masing-masing dengan hasil: openssl rand -hex 32
SESSION_SECRET=
POSTGRES_USER=sas
POSTGRES_PASSWORD=
POSTGRES_DB=sas
DATABASE_URL=postgres://sas:ISI_PASSWORD@127.0.0.1:5432/sas
SEED_EMAIL_DOMAIN=sekolah.example
# Wajib unik minimal 12 karakter untuk inisialisasi produksi.
SEED_PASSWORD=
SEED_MODE=school
# APP_IMAGE=ghcr.io/USERNAME/sas-opensource:latest
