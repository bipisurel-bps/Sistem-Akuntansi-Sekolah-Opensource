# Identitas publik. Kutip nama yang mengandung spasi.
APP_NAME="Sistem Akuntansi Sekolah (SAS) Open Source"
INSTITUTION_NAME="Yayasan Pendidikan Contoh"
SCHOOL_NAME="Sekolah SAS"

# Server manual dan port host Docker.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_PORT=3000
# Opsional: email penerima permintaan bantuan instalasi dari halaman produk.
SUPPORT_EMAIL=
SESSION_SECRET=sas-local-demo-only-change-before-production-2026
# Aktifkan kedua opsi ini bila memakai reverse proxy HTTPS produksi.
COOKIE_SECURE=false
TRUST_PROXY=false

# Manual: URL-encode karakter khusus pada password DATABASE_URL.
DATABASE_URL=postgres://sas:sas_local_password@127.0.0.1:5432/sas
# Compose membentuk URL internal dari nilai berikut; gunakan password alfanumerik.
POSTGRES_USER=sas
POSTGRES_PASSWORD=sas_local_password
POSTGRES_DB=sas

# Akun admin1@sekolah.example dan operator@sekolah.example.
# Data contoh tahun 2026. Ganti sandi sebelum penggunaan bersama.
SEED_EMAIL_DOMAIN=sekolah.example
SEED_PASSWORD=sasDemo123!
# demo = contoh bertransaksi; school = sekolah baru tanpa jurnal/siswa/tagihan demo.
# Hanya berlaku pada database kosong saat inisialisasi pertama.
SEED_MODE=demo

# Database TERPISAH: tes menghapus dan membuat ulang skema database ini.
TEST_DATABASE_URL=postgres://sas:sas_local_password@127.0.0.1:5432/sas_test
